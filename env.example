# Supabase (create a free project, run supabase/schema.sql in the SQL editor)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Admin panel password (choose a long one) and cookie signing secret
ADMIN_PASSWORD=
ADMIN_SECRET=

# Public site URL, used for sitemap and links
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app

# WhatsApp number (international format, digits only) that receives store applications
NEXT_PUBLIC_ADMIN_WHATSAPP=27000000000
